+    static bool ClassIdForName(std::string const& name, uint8& outClassId)
+    {
+        static std::unordered_map<std::string, uint8> const classes = {
+            {"warrior", CLASS_WARRIOR}, {"paladin", CLASS_PALADIN}, {"hunter", CLASS_HUNTER},
