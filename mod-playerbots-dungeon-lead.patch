diff --git a/conf/playerbots.conf.dist b/conf/playerbots.conf.dist
index bcf2600f..680f385f 100644
--- a/conf/playerbots.conf.dist
+++ b/conf/playerbots.conf.dist
@@ -411,6 +411,50 @@ AiPlayerbot.ContactDistance = 0.45
 AiPlayerbot.AoeRadius = 10
 AiPlayerbot.RpgDistance = 200
 AiPlayerbot.GrindDistance = 75.0
+
+# Dungeon lead ("startdungeon"/"stopdungeon" whispered to a bot inside a 5-man dungeon): the bot becomes
+# group leader, the other bots follow it (formation "leader"), and it walks the hand-authored route
+# from playerbots_dungeon_route, grinding on the way and marking bosses (skull) / CC targets (moon).
+# HealerManaPct: do not pull / walk on while a healer is below this mana %.
+# Leash: never walk further than this from the real player (yards); members may lag 1.5x this.
+# ArriveDistance: a route stop counts as reached within this distance (yards).
+# StuckSeconds: no progress towards a stop for this long -> skip it.
+# SkipOptional: 1 = skip optional bosses on the route.  MarkCc: 1 = also mark a moon CC target.
+AiPlayerbot.DungeonLead.HealerManaPct = 20
+AiPlayerbot.DungeonLead.Leash = 60
+AiPlayerbot.DungeonLead.ArriveDistance = 8
+AiPlayerbot.DungeonLead.StuckSeconds = 45
+AiPlayerbot.DungeonLead.CcTimeoutSeconds = 10
+AiPlayerbot.DungeonLead.SkipOptional = 0
+AiPlayerbot.DungeonLead.MarkCc = 1
+
+# DebugDefault: 1 = every "startdungeon" starts with verbose debug logging already on (see
+# DungeonLeadDebug.log). Leave at 0 for a normal install - turn it on per-run with "startdungeon
+# debug" instead. A server that wants it always on for troubleshooting can set this to 1.
+AiPlayerbot.DungeonLead.DebugDefault = 0
+
+# Dungeon Lead always writes a structured DungeonLeadSessions.csv (one row per run event: player,
+# dungeon, tank, group, event, detail) next to Playerbots.log, no config needed. "startdungeon debug"
+# additionally writes a verbose per-wait DungeonLeadDebug.log (position, distance to every group
+# member). Both use plain file I/O, not the AC logger config, so they work the same on every
+# server. See README "Debugging" for what each file contains and where to send it.
+
+# AutoBot Canary: unattended dungeon-lead testing, off by default. When CanaryEnabled=1, the
+# server auto-starts a dungeon-lead session on any already-formed, all-bot 5-man group that
+# queued via LFG for one of the dungeons named in CanaryAllowedLfgIds - it never forms or
+# teleports a group itself, and it never touches a group with a real player in it, at start or
+# mid-session (a real player joining stops the canary session immediately). See README/CHANGELOG
+# and docs/architecture/ for the full design and its current, deliberately narrow scope.
+# CanaryEnabled: 1 = turn the controller on. Still does nothing until CanaryAllowedLfgIds is set.
+# CanaryAllowedLfgIds: comma-separated LFG dungeon ids to auto-test, e.g. "1" for Ragefire Chasm.
+#   Empty (default) = nothing auto-starts even with CanaryEnabled=1. Find ids via lfg_dungeon_template.
+# CanaryMaxConcurrent: how many canary sessions may run at once across the whole server.
+# CanaryTimeoutMinutes: force-stop a canary session that never reaches a terminal outcome.
+AiPlayerbot.DungeonLead.CanaryEnabled = 0
+AiPlayerbot.DungeonLead.CanaryAllowedLfgIds =
+AiPlayerbot.DungeonLead.CanaryMaxConcurrent = 1
+AiPlayerbot.DungeonLead.CanaryTimeoutMinutes = 45
+
 AiPlayerbot.ReactDistance = 150.0
 
 #
